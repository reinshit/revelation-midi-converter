{
  "schema_version": 1,
  "source": {
    "repository": "https://github.com/cuikho210/revelation-mobile-midi-to-mml",
    "commit": "4b04592",
    "rust_package": "midi-to-mml",
    "rust_package_version": "0.2.0"
  },
  "scope": {
    "port_now": ["lib"],
    "defer": ["lib_player", "gui", "gui/native/hub"]
  },
  "defaults": {
    "auto_boot_velocity": false,
    "auto_equalize_note_length": false,
    "velocity_min": 0,
    "velocity_max": 15,
    "min_gap_for_chord": 0,
    "smallest_unit": 64,
    "fallback_ppq": 480
  },
  "bridge_event_schema": {
    "tag_field": "type",
    "variants": {
      "note": ["key", "velocity", "position_ticks", "duration_ticks", "channel"],
      "tempo": ["bpm", "position_ticks"],
      "program_change": ["program", "channel", "instrument_name", "position_ticks"]
    },
    "sort": ["position_ticks ascending", "meta/program before note at equal tick", "stable for remaining ties"]
  },
  "mml_event_schema": {
    "tag_field": "type",
    "variants": {
      "note": ["key", "pitch", "octave", "velocity", "position_units", "duration_units", "is_chord_member", "mml", "mml_note_length"],
      "rest": ["duration_units"],
      "tempo": ["bpm", "position_units"],
      "octave": ["value"],
      "octave_up": [],
      "octave_down": [],
      "chord": [],
      "velocity": ["value"]
    }
  },
  "pipeline": [
    "read_smf",
    "extract_absolute_events",
    "build_bridge_events",
    "merge_global_meta_into_tracks",
    "stable_sort_bridge_events",
    "build_raw_mml_events",
    "normalize_events",
    "fix_event_positions",
    "normalize_events",
    "update_chord_durations",
    "render_note_durations"
  ],

  "compatibility_issues": [
    "B01_active_note_identity_ignores_channel",
    "B02_repeated_same_key_note_on_overwrites",
    "B03_smpte_falls_back_to_480_ppq",
    "B04_track_instrument_is_last_program_change",
    "B05_min_gap_units_differ_between_convert_and_split",
    "B06_keymap_does_not_regenerate_octave_controls",
